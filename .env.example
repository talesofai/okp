# okp 环境变量
# 复制此文件为 .env 并填入实际值

# ── 数据库 ───────────────────────────────────────────────
# PostgreSQL 连接（可选，当 OKP_DATABASE_TYPE=sqlite 时不需要）
OKP_DATABASE_URL=postgres://user:password@localhost:5432/okp?sslmode=disable

# 数据库类型: postgres | sqlite
OKP_DATABASE_TYPE=postgres

# SQLite 文件路径（仅 OKP_DATABASE_TYPE=sqlite 时生效）
OKP_SQLITE_PATH=./okp.db

# ── 服务 ───────────────────────────────────────────────
# API 服务端口
OKP_API_PORT=8720

# 日志级别: debug, info, warn, error
OKP_LOG_LEVEL=info

# ── 认证（按优先级）────────────────────────────────────
# 1. Execution Grant — 共享 cohub API 的 APP_ENCRYPTION_KEY，
#    用于在 cohub sandbox 中验证 COHUB_EXECUTION_TOKEN
OKP_EXECUTION_GRANT_KEY=

# 2. Cohub work_session — Work 前端通过 Cohub SDK 获取的 work token
#    同样使用 APP_ENCRYPTION_KEY 签发（HS256，typ=work_session）
#    自动复用 OKP_EXECUTION_GRANT_KEY 验签，无需额外配置

# 3. Logto JWT — 通过 cohub CLI 登录（cohub auth login）的 token，
#    自动从 {OKP_LOGTO_ENDPOINT}/oidc/jwks 下载公钥验证
OKP_LOGTO_ENDPOINT=https://auth.neta.art
OKP_LOGTO_RESOURCE=https://api.talesofai

# 4. 静态 API Token（向下兼容，不推荐）
OKP_API_TOKEN=

# ── CLI ───────────────────────────────────────────────
# CLI 默认连接的 API 地址
# 在 cohub sandbox 中 CLI 会自动使用 COHUB_EXECUTION_TOKEN
OKP_API_BASE=https://okp.neta.art

# ── 权限控制 ──────────────────────────────────────────
# 所有认证用户默认 role=reader（只读）。
# 管理员直接在数据库里把 users.role 改成 "writer" 即可授权写入，无需重启。
# UPDATE users SET role = 'writer' WHERE uuid = '<user_uuid>';

# per-domain token 控制写入权限（可选，向下兼容）
# 格式：domain1:token1,domain2:token2
OKP_DOMAIN_TOKENS=
