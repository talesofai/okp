# okp 环境变量
# 复制此文件为 .env 并填入实际值

# PostgreSQL 连接（必需）
OKP_DATABASE_URL=postgres://user:password@localhost:5432/okp?sslmode=disable

# API 服务端口
OKP_API_PORT=8720

# API 认证 token（Bearer Token，CLI 和外部调用使用）
OKP_API_TOKEN=change-me-in-production

# CLI 默认连接的 API 地址
OKP_API_BASE=http://localhost:8720

# 日志级别: debug, info, warn, error
OKP_LOG_LEVEL=info

# 写入 domain token（可选，per-domain 细粒度控制；格式：domain1:token1,domain2:token2）
OKP_DOMAIN_TOKENS=
